# Google Analytics Measurement ID (optional)
# Get your GA4 Measurement ID from https://analytics.google.com/
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google AdSense Publisher ID (optional)
# Get your AdSense Publisher ID from https://www.google.com/adsense/
# Format: ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_ID=ca-pub-XXXXXXXXXXXXXXXX

# Cloudflare Web Analytics beacon token (optional; defaults to the production token)
# Set to an empty string to disable.
# NEXT_PUBLIC_CF_BEACON_TOKEN=
